# Firebase Web App Configuration
# Leave blank to run in local real-time preview mode.
# Fill in all VITE_FIREBASE_* values from your Firebase Console to enable live Cloud Firestore + Google Auth.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of up to 5 authorized Google account emails (lowercase)
# Must match the emails configured in firestore.rules
VITE_ALLOWED_STAFF_EMAILS=owner@xinyue.tw,frontdesk@xinyue.tw,manager@xinyue.tw
